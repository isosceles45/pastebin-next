# Neon Postgres connection string.
# Dashboard -> your project -> Connect -> enable "Connection pooling" -> copy.
# The host should contain "-pooler" and the string should end in ?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Optional. Protects /api/cleanup so only the scheduled job can call it.
# When unset, the endpoint is open (fine locally, set it in production).
# CRON_SECRET="a-long-random-string"
